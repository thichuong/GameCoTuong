{
  "name": "game-co-tuong",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit",
    "test": "npx tsx --test src/**/*.test.ts",
    "preview": "vite preview",
    "deploy": "npm run build && npx wrangler deploy",
    "build:wasm": "cargo build -p cotuong_core --target wasm32-unknown-unknown --release && wasm-bindgen --target web --out-dir src/wasm target/wasm32-unknown-unknown/release/cotuong_core.wasm",
    "train": "bash train.sh"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "lucide-react": "^1.68.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^4.158.0"
  }
}
