# Node / Vite
node_modules/
**/node_modules/
dist/
**/dist/
.wrangler/

# Generated by Cargo
# will have compiled files and executables
debug/
target/
/dist
dist/*
client/dist/*

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# External Xiangqi Engines (Pikafish, Fairy-Stockfish, Eleeye, etc.)
/engines/
engines/*

# Training Checkpoints (Intermediate NNUE checkpoints per epoch)
/checkpoints/
checkpoints/*

.aistudio/
.aistudio

# Auto-generated Arena Data (per-session training data from Pikafish vs Fairy-Stockfish)
/cotuong_trainer/data/generated/
cotuong_trainer/data/generated/*
/cotuong_trainer/data/arena_*.txt
cotuong_trainer/data/arena_*.txt
